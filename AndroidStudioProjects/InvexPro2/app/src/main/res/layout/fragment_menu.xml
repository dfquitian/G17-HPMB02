<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F0F0F0">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Menú InvexPro"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Button android:id="@+id/btn_producto" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Producto" />
    <Button android:id="@+id/btn_fotos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fotos" />
    <Button android:id="@+id/btn_video" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Video" />
    <Button android:id="@+id/btn_proveedor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Proveedor" />
</LinearLayout>